{
  "name": "web-security-observatory-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Authorized-use webapp debugging and request replay workspace",
  "author": "Web Security Observatory contributors",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.websecurityobservatory.desktop",
    "productName": "Web Security Observatory",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "ui/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3"
  }
}
